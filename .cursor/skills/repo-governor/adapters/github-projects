#!/usr/bin/env python3
"""RoadmapAuthorityProvider backed by GitHub Issues + Projects v2 (spec §11).

The SECOND roadmap provider (§62), so ADR-008 Layer 2 can test whether
semantically equivalent state produces equivalent dispositions across
providers. That is the thesis test — issue #1.

Two modes:
  live     shells out to `gh api graphql` (needs gh + read:project)
  fixture  reads a captured response — set REPO_GOVERNOR_GH_FIXTURE

Conformance runs in fixture mode. ADR-008 rule 1: fixtures are recorded,
not live, because determinism is only assertable against fixed inputs.

NORMALIZATION IS THE HARD PART. GitHub has no "authority" field. The map
below is an interpretation, and every judgement call in it is a place the
two providers can silently diverge. It is written out explicitly rather
than buried so Layer 2 can argue with it.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
from _protocol import cite, fail, main, ok, unknown  # noqa: E402

ROLE = "roadmap_authority"
FIXTURE = os.environ.get("REPO_GOVERNOR_GH_FIXTURE")
# Repository identity is NEVER defaulted (ADR-028). This read
# the author's own repository slug until 2026-08-17, so any other repository that
# did not set it got confident, well-provenanced answers about that project
# (#26). An adapter that cannot determine WHICH system it is reading must fail,
# not guess -- the same rule ADR-003 rule 6 states for absence versus unknown.
NWO = os.environ.get("REPO_GOVERNOR_GH_REPO", "")

# ADR-018: the admission signal is DECLARED, never assumed. No fallback chain --
# trying Projects then milestones then labels would be the adapter deciding what
# admission means in someone else's repository.
ADMISSION = os.environ.get("REPO_GOVERNOR_GH_ADMISSION", "")
ADMISSION_SIGNALS = ("project_status", "milestone", "label", "none")
# Same rule one level down. ADR-018 made the admission SIGNAL declared; its
# parameters were still guessed. Defaulting to `admitted` / `ready` picks label
# names in someone else's repository, which is what ADR-018 refused (#26).
ADMISSION_LABEL = os.environ.get("REPO_GOVERNOR_GH_ADMISSION_LABEL", "")
AUTHORIZE_LABEL = os.environ.get("REPO_GOVERNOR_GH_AUTHORIZE_LABEL", "")

# Fetch ONE issue by number. The previous query paged `issues(first:50)` and
# searched the result, which silently returned NOT_FOUND for any issue outside
# that window. Verified against a real repository with 380 issues: #1391 exists
# and was reported as not existing. NOT_FOUND means "this work item does not
# exist", so a pagination limit was being reported as an absence of authority.
# `projectItems` is requested ONLY under the `project_status` signal. It used to
# be requested always, which cost a real run: a token without Projects read made
# `gh` exit 1, the adapter reported the whole provider unavailable, and the
# engine returned a blocking UNKNOWN -- on a repository whose declared signal is
# `milestone`, whose milestone field the same response had already returned
# successfully. Every fact needed to answer was in hand and the answer was
# refused because of a field nobody had asked a question about.
#
# Asking for a permission the declared signal does not need is also just
# over-reach (§51 least privilege, ADR-005): the adapter should require exactly
# the access its configuration implies, and no more.
_PROJECT_ITEMS = """
        projectItems(first:5) {
          nodes {
            project { number title }
            fieldValues(first:20) {
              nodes {
                ... on ProjectV2ItemFieldSingleSelectValue { name field { ... on ProjectV2SingleSelectField { name } } }
              }
            }
          }
        }
"""

ISSUE_QUERY = """
query($owner:String!, $repo:String!, $number:Int!) {
  repository(owner:$owner, name:$repo) {
    issue(number:$number) {
        number title state stateReason
        labels(first:20){ nodes{ name } }
        assignees(first:5){ nodes{ login } }
        milestone { title state }
%s
    }
  }
}
""" % (_PROJECT_ITEMS if ADMISSION == "project_status" else "")

# --- the normalization map, stated explicitly -------------------------------
# Board status -> whether execution is authorized. GitHub cannot express
# "admitted but not authorized" natively; the Status column is the closest
# proxy, which is itself a judgement.
STATUS_AUTHORIZES = {
    "Ready": "AUTHORIZED",
    "In progress": "AUTHORIZED",
    "In review": "AUTHORIZED",
    "Backlog": "ADMITTED",       # on the board, not cleared to execute
    "Done": "AUTHORIZED",        # was authorized; completion is a separate axis
}
# Closed-issue reasons.
CLOSED_REASON = {
    "NOT_PLANNED": "CANCELLED",
    "DUPLICATE": "CANCELLED",
    "COMPLETED": None,           # defer to board status
}



def _require_repo(fn):
    """Identity is declared or the provider is unavailable. Never guessed (ADR-028)."""
    owner, _, repo = NWO.partition("/")
    if not NWO:
        return fail(ROLE, fn, "PROVIDER_UNAVAILABLE",
                    "no repository declared. Set providers.<role>.env.REPO_GOVERNOR_GH_REPO "
                    "in the manifest to 'owner/repo'. An adapter that cannot tell which "
                    "repository it is reading must not answer.")
    if not repo:
        return fail(ROLE, fn, "BAD_REQUEST", f"REPO_GOVERNOR_GH_REPO={NWO!r} is not owner/repo")
    return None


def _fetch_one(fn, number):
    """Fetch a single issue by number. Live mode only; fixtures use _fetch."""
    err = _require_repo(fn)
    if err:
        return None, err
    owner, _, repo = NWO.partition("/")
    try:
        p = subprocess.run(
            ["gh", "api", "graphql", "-f", f"query={ISSUE_QUERY}", "-f", f"owner={owner}",
             "-f", f"repo={repo}", "-F", f"number={number}"],
            capture_output=True, text=True, timeout=60,
        )
    except FileNotFoundError:
        return None, fail(ROLE, fn, "PROVIDER_UNAVAILABLE", "gh CLI is not installed")
    except subprocess.TimeoutExpired:
        return None, fail(ROLE, fn, "PROVIDER_UNAVAILABLE", "gh api timed out")
    if p.returncode != 0:
        return None, fail(ROLE, fn, "PROVIDER_UNAVAILABLE", f"gh api failed: {p.stderr.strip()[:200]}")
    try:
        data = json.loads(p.stdout)
    except json.JSONDecodeError as e:
        return None, fail(ROLE, fn, "MALFORMED_SOURCE", f"gh returned non-JSON: {e}")
    node = (((data.get("data") or {}).get("repository") or {}).get("issue"))
    if node is None:
        return None, fail(ROLE, fn, "NOT_FOUND", f"no issue #{number} in {NWO}")
    return node, None


def _fetch(fn):
    if FIXTURE:
        p = Path(FIXTURE)
        if not p.exists():
            return None, fail(ROLE, fn, "PROVIDER_UNAVAILABLE", f"fixture {FIXTURE!r} does not exist")
        try:
            return json.loads(p.read_text()), None
        except json.JSONDecodeError as e:
            return None, fail(ROLE, fn, "MALFORMED_SOURCE", f"fixture is not valid JSON: {e}")
    err = _require_repo(fn)
    if err:
        return None, err
    owner, _, repo = NWO.partition("/")
    try:
        p = subprocess.run(
            ["gh", "api", "graphql", "-f", f"query={QUERY}", "-f", f"owner={owner}", "-f", f"repo={repo}"],
            capture_output=True, text=True, timeout=60,
        )
    except FileNotFoundError:
        return None, fail(ROLE, fn, "PROVIDER_UNAVAILABLE", "gh CLI is not installed")
    except subprocess.TimeoutExpired:
        return None, fail(ROLE, fn, "PROVIDER_UNAVAILABLE", "gh api timed out")
    if p.returncode != 0:
        return None, fail(ROLE, fn, "PROVIDER_UNAVAILABLE", f"gh api failed: {p.stderr.strip()[:200]}")
    try:
        return json.loads(p.stdout), None
    except json.JSONDecodeError as e:
        return None, fail(ROLE, fn, "MALFORMED_SOURCE", f"gh returned non-JSON: {e}")


def _raw_from_stdin():
    """Option C (#18): the agent supplies raw provider output; we only normalize."""
    if "--input" not in sys.argv:
        return None
    i = sys.argv.index("--input")
    src = sys.argv[i + 1] if len(sys.argv) > i + 1 else "-"
    return sys.stdin.read() if src == "-" else Path(src).read_text()


def _find_in_raw(fn, num, raw):
    """One normalizer, two payload shapes — #18 Q1, answered structurally.

    GitHub's list query returns `repository.issues.nodes`; the single-issue query
    returns `repository.issue`. An agent holding either an MCP connection or `gh`
    may hand over either. They are told apart by shape, not by a transport flag,
    which is why this does not reintroduce the per-transport matrix from #17:
    the variance is in the payload, and the payload describes itself.

    A response about the wrong issue is refused rather than normalized (#18 Q2).
    """
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as e:
        return None, fail(ROLE, fn, "MALFORMED_SOURCE", f"supplied input is not valid JSON: {e}")
    repo = ((data.get("data") or {}).get("repository") or {}) if isinstance(data, dict) else {}
    if not repo:
        return None, fail(ROLE, fn, "MALFORMED_SOURCE",
                          "supplied input is not a GitHub repository GraphQL response")
    if "issue" in repo:
        node = repo.get("issue")
        if node is None:
            return None, fail(ROLE, fn, "NOT_FOUND", f"supplied input contains no issue #{num}")
        if node.get("number") != num:
            return None, fail(ROLE, fn, "MALFORMED_SOURCE",
                              f"supplied input is about issue #{node.get('number')}, "
                              f"not the requested #{num}")
        return node, None
    nodes = (repo.get("issues") or {}).get("nodes")
    if nodes is None:
        return None, fail(ROLE, fn, "MALFORMED_SOURCE",
                          "supplied input has neither `issue` nor `issues.nodes`")
    for n in nodes:
        if n.get("number") == num:
            return n, None
    # A list payload is a page. Absence within it is not absence in the provider
    # — the same page-boundary trap _fetch_one exists to avoid.
    return None, fail(ROLE, fn, "NOT_FOUND",
                      f"issue #{num} is not in the supplied page of {len(nodes)} issue(s); "
                      "supply a single-issue response to assert absence")


def _issues(fn):
    data, err = _fetch(fn)
    if err:
        return None, err
    try:
        return data["data"]["repository"]["issues"]["nodes"], None
    except (KeyError, TypeError):
        return None, fail(ROLE, fn, "MALFORMED_SOURCE", "unexpected GraphQL shape")


def _find(fn, kw):
    wid = kw.get("id")
    if not wid:
        return None, fail(ROLE, fn, "BAD_REQUEST", "missing required argument: id=<issue-number>")
    num = wid[1:] if wid.startswith("#") else wid
    if not num.isdigit():
        return None, fail(ROLE, fn, "BAD_REQUEST", f"id must be an issue number, got {wid!r}")
    raw = _raw_from_stdin()
    if raw is not None:
        return _find_in_raw(fn, int(num), raw)
    if not FIXTURE:
        # Live: ask for the one issue. Never infer absence from a page boundary.
        return _fetch_one(fn, int(num))
    nodes, err = _issues(fn)
    if err:
        return None, err
    for n in nodes:
        if n["number"] == int(num):
            return n, None
    return None, fail(ROLE, fn, "NOT_FOUND", f"no issue #{num} in fixture {FIXTURE}")


def _status(node):
    for pi in node.get("projectItems", {}).get("nodes", []):
        for fv in pi.get("fieldValues", {}).get("nodes", []):
            if fv and fv.get("field", {}).get("name") == "Status":
                return fv.get("name"), pi["project"]["number"]
    return None, None


def _ref(node, field):
    return cite("github-projects", f"{NWO}#issues.{node['number']}", field)


def get_work(kw):
    node, err = _find("get_work", kw)
    if err:
        return err
    return ok(ROLE, "get_work",
              {"id": f"#{node['number']}", "title": node["title"], "exists": True},
              [_ref(node, "title")])


def get_status(kw):
    node, err = _find("get_status", kw)
    if err:
        return err
    st, _ = _status(node)
    return ok(ROLE, "get_status",
              {"status": st or node["state"]},
              [_ref(node, "projectItems.Status" if st else "state")])


def _labels(node):
    return [l["name"] for l in (node.get("labels") or {}).get("nodes", [])]


def get_authority(kw):
    """Where normalization actually bites. GitHub has no authority field."""
    node, err = _find("get_authority", kw)
    if err:
        return err

    if not ADMISSION:
        return unknown(ROLE, "get_authority",
                       reason="ADMISSION_SIGNAL_UNDECLARED",
                       detail=("No admission signal declared for this binding. GitHub expresses "
                               "admission by convention -- a Project column, a milestone, a label -- "
                               "and choosing one for you would be the adapter deciding what "
                               "admission means in your repository (ADR-018)."),
                       resolution="Declare admission.signal in the manifest: "
                                  + ", ".join(ADMISSION_SIGNALS),
                       blocking=True)
    if ADMISSION not in ADMISSION_SIGNALS:
        return fail(ROLE, "get_authority", "MALFORMED_SOURCE",
                    f"admission signal {ADMISSION!r} is not in {list(ADMISSION_SIGNALS)}")

    st, proj = _status(node)

    if node["state"] == "CLOSED":
        mapped = CLOSED_REASON.get(node.get("stateReason") or "", "CANCELLED")
        if mapped:
            return ok(ROLE, "get_authority", {"authority": mapped, "admitted": False},
                      [_ref(node, "stateReason")])

    if ADMISSION == "none":
        return unknown(ROLE, "get_authority",
                       reason="NOT_ADMITTED",
                       detail=f"Issue #{node['number']} exists, but this binding declares "
                              "admission signal 'none': admission is never inferred here.",
                       resolution="Declare a real admission signal, or admit work in another provider.",
                       blocking=True)

    if ADMISSION == "milestone":
        ms = node.get("milestone")
        if not ms:
            return unknown(ROLE, "get_authority",
                           reason="NOT_ADMITTED",
                           detail=f"Issue #{node['number']} is in no milestone. Under the declared "
                                  "'milestone' signal, milestone membership is admission.",
                           resolution="Assign the issue to a milestone, or change the declared signal.",
                           blocking=True)
        # Authorization within the milestone signal: an assignee, or the issue
        # having been closed. Closure is included because the alternative reads
        # finished work as "admitted but not cleared to execute", which is
        # actively wrong -- and because assignees are routinely absent on closed
        # issues, so assignee alone makes authority evaporate at completion.
        # Completion is a separate axis and must not retract authority (section 40).
        # This is not a fallback across signals, which ADR-018 forbids; it is the
        # milestone signal's own definition, stated rather than assumed.
        assigned = bool((node.get("assignees") or {}).get("nodes"))
        closed = node.get("state") == "CLOSED"
        if assigned or closed:
            return ok(ROLE, "get_authority", {"authority": "AUTHORIZED", "admitted": True},
                      [_ref(node, "milestone.title"),
                       _ref(node, "assignees" if assigned else "state")])
        return ok(ROLE, "get_authority", {"authority": "ADMITTED", "admitted": True},
                  [_ref(node, "milestone.title"), _ref(node, "assignees")])

    if ADMISSION == "label":
        if not ADMISSION_LABEL:
            return unknown(ROLE, "get_authority",
                           reason="ADMISSION_SIGNAL_UNDECLARED",
                           detail=("Signal 'label' is declared but no label name is. Picking "
                                   "'admitted' would be the adapter choosing what admission means "
                                   "in your repository, which ADR-018 refuses one level up (#26)."),
                           resolution="Declare admission.admission_label, and admission.authorize_label "
                                      "if authorization is also label-driven.",
                           blocking=True)
        names = _labels(node)
        if AUTHORIZE_LABEL in names:
            return ok(ROLE, "get_authority", {"authority": "AUTHORIZED", "admitted": True},
                      [_ref(node, f"labels[{AUTHORIZE_LABEL}]")])
        if ADMISSION_LABEL in names:
            return ok(ROLE, "get_authority", {"authority": "ADMITTED", "admitted": True},
                      [_ref(node, f"labels[{ADMISSION_LABEL}]")])
        return unknown(ROLE, "get_authority",
                       reason="NOT_ADMITTED",
                       detail=f"Issue #{node['number']} carries neither {ADMISSION_LABEL!r} nor "
                              f"{AUTHORIZE_LABEL!r}. Under the declared 'label' signal, those labels are admission.",
                       resolution=f"Apply {ADMISSION_LABEL!r}, or change the declared signal.",
                       blocking=True)

    if st is None:
        return unknown(ROLE, "get_authority",
                       reason="NOT_ON_BOARD",
                       detail=f"Issue #{node['number']} is not an item on any Project, so no "
                              "admission or authorization state can be read.",
                       resolution="Add the issue to the roadmap Project, or bind a different roadmap authority.",
                       blocking=True)
    mapped = STATUS_AUTHORIZES.get(st)
    if mapped is None:
        return fail(ROLE, "get_authority", "MALFORMED_SOURCE",
                    f"board Status {st!r} is not in the normalization map {sorted(STATUS_AUTHORIZES)}")
    return ok(ROLE, "get_authority",
              {"authority": mapped, "admitted": True},
              [_ref(node, f"projectItems[{proj}].Status")])


def get_scope(kw):
    node, err = _find("get_scope", kw)
    if err:
        return err
    return unknown(ROLE, "get_scope",
                   reason="SCOPE_NOT_STRUCTURED",
                   detail=f"Issue #{node['number']} has no structured scope. GitHub issue bodies are "
                          "free prose, which ADR-012 forbids interpreting as typed facts.",
                   resolution="Use a tracker with structured scope fields, or declare scope in the manifest.",
                   blocking=False)


def get_non_goals(kw):
    node, err = _find("get_non_goals", kw)
    if err:
        return err
    return unknown(ROLE, "get_non_goals",
                   reason="NON_GOALS_UNSTATED",
                   detail=f"Issue #{node['number']} declares no structured non_goals; "
                          "the scope envelope will be thin.",
                   resolution="Add explicit non-goals in a structured field.",
                   blocking=False)


def get_acceptance_conditions(kw):
    node, err = _find("get_acceptance_conditions", kw)
    if err:
        return err
    return unknown(ROLE, "get_acceptance_conditions",
                   reason="ACCEPTANCE_UNSTATED",
                   detail=f"Issue #{node['number']} has no machine-checkable acceptance conditions.",
                   resolution="Add a structured acceptance field, or accept that completion cannot be verified.",
                   blocking=False)


def get_parent_or_goal(kw):
    node, err = _find("get_parent_or_goal", kw)
    if err:
        return err
    ms = node.get("milestone")
    return ok(ROLE, "get_parent_or_goal", {"parent": ms["title"] if ms else None},
              [_ref(node, "milestone")])


def get_decision_history(kw):
    node, err = _find("get_decision_history", kw)
    if err:
        return err
    hist = []
    if node["state"] == "CLOSED":
        hist.append({
            "disposition": CLOSED_REASON.get(node.get("stateReason") or "", "CANCELLED") or "COMPLETED",
            "reason": f"issue closed as {node.get('stateReason')}",
            "reversal_condition": None,
        })
    return ok(ROLE, "get_decision_history", {"history": hist}, [_ref(node, "stateReason")])


def _probe():
    import shutil
    return bool(FIXTURE and Path(FIXTURE).exists()) or (not FIXTURE and shutil.which("gh") is not None)


FUNCTIONS = {
    "get_work": get_work,
    "get_status": get_status,
    "get_authority": get_authority,
    "get_scope": get_scope,
    "get_non_goals": get_non_goals,
    "get_acceptance_conditions": get_acceptance_conditions,
    "get_parent_or_goal": get_parent_or_goal,
    "get_decision_history": get_decision_history,
}

PROPERTIES = {
    "persistence": True,
    # Weaker than file-roadmap: authority is INFERRED from board status,
    # not read from a field that means authority.
    "provenance_quality": "inferred",
}

CAPABILITIES = {
    "work_lookup": True,
    "status": True,
    "authority": True,
    "cancellation_detection": True,
    "decision_history": True,
    "scope": False,                  # honest: always UNKNOWN
    "non_goals": False,              # honest: always UNKNOWN
    "acceptance_conditions": False,  # honest: always UNKNOWN
}

def _configured():
    """Identity is never defaulted (ADR-028), so an unset repository means this
    adapter can answer nothing -- and --validate used to call that ready."""
    if FIXTURE:
        return True, None
    if not NWO:
        return False, ("no repository declared; set providers.<role>.env."
                       "REPO_GOVERNOR_GH_REPO to owner/name. Identity is never "
                       "defaulted (ADR-028), so every query will refuse.")
    return True, None

if __name__ == "__main__":
    sys.exit(main(ROLE, CAPABILITIES, FUNCTIONS,
                  {"name": "github-projects",
                   "permissions": {"read": True, "write": False},
                   "mode": "fixture" if FIXTURE else "live"},
                  properties=PROPERTIES, probe=_probe, config_probe=_configured))
