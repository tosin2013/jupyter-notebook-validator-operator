#!/usr/bin/env python3
"""RoadmapAuthorityProvider backed by Linear (spec §11).

THIRD roadmap provider, and the first sharp test of normalization (#1).
Linear's workflow-state model does not line up with GitHub Projects:

  Linear state type   meaning                          GitHub equivalent
  -----------------   ------------------------------   -----------------
  triage              filed, NOT yet admitted          none
  backlog             admitted, not scheduled          "Backlog"
  unstarted           scheduled, ready to start        "Ready"
  started             in progress                      "In progress"
  completed           done                             "Done"
  canceled            authority withdrawn              closed NOT_PLANNED

`triage` is the interesting one: Linear can express "this exists but has not
been admitted", which GitHub Projects cannot. INV-002 depends on exactly that
distinction, so this is where the abstraction either holds or leaks.

Three modes:
  live     POSTs to api.linear.app/graphql with LINEAR_API_KEY
  fixture  reads a captured response — set REPO_GOVERNOR_LINEAR_FIXTURE
  mcp      agent-supplied transport — manifest declares transport.kind=mcp,
           agent fetches via MCP and supplies data through --input - or
           REPO_GOVERNOR_LINEAR_FIXTURE (ADR-020, #124)

Accepts both raw shapes: the GraphQL API nests state as `state.type`, the
Linear MCP server flattens it to `statusType`. Shape normalization happens
at the edge so a single semantic map serves both transports.

NOTE: the live path is implemented but UNVERIFIED — no Linear credentials
were available when this was written. Only fixture mode has been executed.
Treat live mode as untested until someone runs it against a real workspace.
"""

from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
from _protocol import binding, cite, fail, main, ok, unknown  # noqa: E402

ROLE = "roadmap_authority"
FIXTURE = os.environ.get("REPO_GOVERNOR_LINEAR_FIXTURE")
API_KEY = os.environ.get("LINEAR_API_KEY")
ENDPOINT = "https://api.linear.app/graphql"
TEAM = os.environ.get("REPO_GOVERNOR_LINEAR_TEAM", "")

QUERY = """
query {
  issues(first: 50) {
    nodes {
      identifier title
      state { name type }
      project { name }
      parent { identifier }
      labels(first: 10) { nodes { name } }
    }
  }
}
"""

# --- normalization map, stated explicitly ----------------------------------
# Linear's `type` is stable across workspaces even when state *names* are
# customized, so mapping on type rather than name is what keeps this portable.
# Verified against a real Linear workspace 2026-08-17. The workspace exposed a
# `duplicate` state type that this map did not have, which would have produced
# MALFORMED_SOURCE on live data -- correct behaviour for an unknown value, but
# the wrong outcome, since duplicate is a real and unambiguous Linear state.
TYPE_AUTHORIZES = {
    "backlog": "ADMITTED",
    "unstarted": "AUTHORIZED",
    "started": "AUTHORIZED",
    "completed": "AUTHORIZED",   # completion is a separate axis (§40)
    "canceled": "CANCELLED",
    "duplicate": "CANCELLED",    # closed as a duplicate: authority withdrawn
}
# `triage` is deliberately absent: it means NOT admitted, which is not a
# value in the authority vocabulary. It must produce a blocking unknown.


def _raw_from_stdin():
    """Option C: the agent (or `linear-fetch`) supplies raw provider output.

    The adapter becomes a pure function raw -> typed facts. It performs no I/O
    of its own, so determinism and mechanical provenance survive while the
    transport problem moves outside (#18).
    """
    if "--input" not in sys.argv:
        return None
    i = sys.argv.index("--input")
    src = sys.argv[i + 1] if len(sys.argv) > i + 1 else "-"
    text = sys.stdin.read() if src == "-" else Path(src).read_text()
    return text


# Required MCP fields. Unlike GraphQL -- where `linear-fetch` owns the query and
# therefore guarantees the shape -- an MCP payload's fields are chosen by the
# CALLER. That is #18 Q4 ("who owns the query specification?") made concrete: the
# adapter cannot control what it is handed, so it publishes what it needs and
# refuses a payload that is merely shaped right but missing meaning.
MCP_REQUIRED = ("id", "title", "status", "statusType")


def _canonical(node):
    """One MCP issue -> the canonical (GraphQL-shaped) node the rest of this file speaks.

    Normalizing the SHAPE once at the boundary keeps ONE semantic map. The
    alternative -- an `or` fallback in each of eight functions -- is a normalizer
    per transport wearing a disguise, which is exactly what #17 warned about.
    """
    return {
        "identifier": node.get("id"),
        "title": node.get("title"),
        "state": {"name": node.get("status"), "type": node.get("statusType")},
        "project": {"name": node["project"]} if node.get("project") else None,
        # MCP exposes `parentId` (an opaque uuid); GraphQL exposes
        # `parent.identifier` (a human key such as ENG-42). Verified NOT the same
        # value, and the MCP tool cannot return the human key in one call. So the
        # difference is carried, not smoothed: `opaque` marks a parent that names
        # nothing a human or another provider could correlate. Returning the uuid
        # as if it answered "what larger goal does this serve?" would be a
        # confident wrong answer -- capabilities belong to (provider x transport).
        "parent": {"identifier": node["parentId"], "opaque": True} if node.get("parentId") else None,
        "labels": {"nodes": [{"name": n} for n in (node.get("labels") or [])]},
    }


def _nodes_from(data, fn):
    """Accept either Linear transport. Shape is detected structurally, never declared.

    GraphQL : {"data": {"issues": {"nodes": [...]}}}
    MCP     : {"issues": [...]}
    """
    if isinstance(data, dict) and isinstance(data.get("data"), dict) and "issues" in data["data"]:
        nodes = (data["data"]["issues"] or {}).get("nodes")
        if not isinstance(nodes, list):
            return None, fail(ROLE, fn, "MALFORMED_SOURCE", "GraphQL payload has no issues.nodes")
        return nodes, None
    if isinstance(data, dict) and isinstance(data.get("issues"), list):
        raw = data["issues"]
        missing = sorted({f for n in raw for f in MCP_REQUIRED if f not in n})
        if missing:
            return None, fail(ROLE, fn, "MALFORMED_SOURCE",
                              f"MCP payload is missing required field(s) {missing}. Request them: "
                              f"fields={list(MCP_REQUIRED)}. Without statusType the semantic state "
                              "cannot be resolved, and guessing it from the display name would be "
                              "the adapter deciding what a workflow state means.")
        return [_canonical(n) for n in raw], None
    return None, fail(ROLE, fn, "MALFORMED_SOURCE",
                      "supplied input is neither a Linear GraphQL response "
                      "({data:{issues:{nodes:[...]}}}) nor an MCP issues payload ({issues:[...]})")


def _fetch(fn):
    raw = _raw_from_stdin()
    if raw is not None:
        try:
            data = json.loads(raw)
        except json.JSONDecodeError as e:
            return None, fail(ROLE, fn, "MALFORMED_SOURCE", f"supplied input is not valid JSON: {e}")
        # Guard #18 Q2: refuse a plausible-looking substitute (a summary, the
        # wrong query) rather than normalizing it. The ADR-015 lesson again.
        # _nodes_from does the refusing, and accepts either transport's shape.
        return data, None
    if FIXTURE:
        p = Path(FIXTURE)
        if not p.exists():
            return None, fail(ROLE, fn, "PROVIDER_UNAVAILABLE", f"fixture {FIXTURE!r} does not exist")
        try:
            return json.loads(p.read_text()), None
        except json.JSONDecodeError as e:
            return None, fail(ROLE, fn, "MALFORMED_SOURCE", f"fixture is not valid JSON: {e}")
    if not API_KEY:
        b = binding()
        if (b.get("transport") or {}).get("kind") == "mcp":
            return None, fail(ROLE, fn, "PROVIDER_UNAVAILABLE",
                              "MCP transport is declared but no input was supplied. "
                              "The agent must fetch Linear issues via MCP with fields "
                              f"{list(MCP_REQUIRED)} and supply them via --input - "
                              "or REPO_GOVERNOR_LINEAR_FIXTURE.")
        return None, fail(ROLE, fn, "PROVIDER_UNAVAILABLE",
                          "LINEAR_API_KEY is not set and no fixture was provided")
    req = urllib.request.Request(
        ENDPOINT,
        data=json.dumps({"query": QUERY}).encode(),
        headers={"Content-Type": "application/json", "Authorization": API_KEY},
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read().decode()), None
    except urllib.error.HTTPError as e:
        return None, fail(ROLE, fn, "PROVIDER_UNAVAILABLE", f"Linear API HTTP {e.code}")
    except urllib.error.URLError as e:
        return None, fail(ROLE, fn, "PROVIDER_UNAVAILABLE", f"Linear API unreachable: {e.reason}")
    except json.JSONDecodeError as e:
        return None, fail(ROLE, fn, "MALFORMED_SOURCE", f"Linear returned non-JSON: {e}")


def _find(fn, kw):
    data, err = _fetch(fn)
    if err:
        return None, err
    nodes, err = _nodes_from(data, fn)
    if err:
        return None, err
    wid = kw.get("id")
    if not wid:
        return None, fail(ROLE, fn, "BAD_REQUEST", "missing required argument: id=<identifier>")
    for n in nodes:
        if n.get("identifier") == wid:
            return n, None
    return None, fail(ROLE, fn, "NOT_FOUND", f"no issue {wid!r} in Linear")


def _ref(node, field):
    return cite("linear", f"linear#{node['identifier']}", field)


def get_work(kw):
    node, err = _find("get_work", kw)
    if err:
        return err
    return ok(ROLE, "get_work",
              {"id": node["identifier"], "title": node["title"], "exists": True},
              [_ref(node, "title")])


def get_status(kw):
    node, err = _find("get_status", kw)
    if err:
        return err
    return ok(ROLE, "get_status", {"status": node["state"]["name"]},
              [_ref(node, "state.name")])


def get_authority(kw):
    node, err = _find("get_authority", kw)
    if err:
        return err
    # Both transports were normalized to one shape by _nodes_from, so this reads
    # `state` unconditionally. The per-function fallback that used to live here
    # was unreachable anyway -- the envelope check rejected MCP payloads before
    # any function saw them.
    st = node.get("state") or {}
    stype = st.get("type")
    if stype is None:
        return fail(ROLE, "get_authority", "MALFORMED_SOURCE",
                    f"{node['identifier']} has no state.type")
    if stype == "triage":
        return unknown(ROLE, "get_authority",
                       reason="NOT_ADMITTED",
                       detail=(f"{node['identifier']} is in Linear triage (state {st.get('name')!r}). "
                               "Triage means filed but not yet admitted to the roadmap; "
                               "admission has not occurred, so authority cannot be read."),
                       resolution="Move the issue out of triage into a workflow state, or admit it explicitly.",
                       blocking=True)
    mapped = TYPE_AUTHORIZES.get(stype)
    if mapped is None:
        return fail(ROLE, "get_authority", "MALFORMED_SOURCE",
                    f"Linear state type {stype!r} is not in the normalization map "
                    f"{sorted(TYPE_AUTHORIZES) + ['triage']}")
    return ok(ROLE, "get_authority",
              {"authority": mapped, "admitted": mapped != "CANCELLED"},
              [_ref(node, "state.type")])


def get_scope(kw):
    node, err = _find("get_scope", kw)
    if err:
        return err
    return unknown(ROLE, "get_scope",
                   reason="SCOPE_NOT_STRUCTURED",
                   detail=f"{node['identifier']} has no structured scope; Linear descriptions are free prose.",
                   resolution="Declare scope in the manifest, or use structured custom fields.",
                   blocking=False)


def get_non_goals(kw):
    node, err = _find("get_non_goals", kw)
    if err:
        return err
    return unknown(ROLE, "get_non_goals",
                   reason="NON_GOALS_UNSTATED",
                   detail=f"{node['identifier']} declares no structured non_goals; the envelope will be thin.",
                   resolution="Add explicit non-goals in a structured field.",
                   blocking=False)


def get_acceptance_conditions(kw):
    node, err = _find("get_acceptance_conditions", kw)
    if err:
        return err
    return unknown(ROLE, "get_acceptance_conditions",
                   reason="ACCEPTANCE_UNSTATED",
                   detail=f"{node['identifier']} has no machine-checkable acceptance conditions.",
                   resolution="Add a structured acceptance field.",
                   blocking=False)


def get_parent_or_goal(kw):
    node, err = _find("get_parent_or_goal", kw)
    if err:
        return err
    pnode = node.get("parent") or {}
    project = (node.get("project") or {}).get("name")
    if pnode.get("opaque") and not project:
        return unknown(ROLE, "get_parent_or_goal",
                       reason="PARENT_NOT_RESOLVABLE_ON_TRANSPORT",
                       detail=(f"{node['identifier']} has a parent, but this transport names it "
                               "only by opaque id. Nothing can correlate that with a work item."),
                       resolution="Read this provider over a transport that returns the parent's "
                                  "identifier, or resolve the id in a second call.",
                       blocking=False)
    parent = None if pnode.get("opaque") else pnode.get("identifier")
    return ok(ROLE, "get_parent_or_goal", {"parent": parent or project},
              [_ref(node, "parent" if parent else "project.name")])


def get_decision_history(kw):
    node, err = _find("get_decision_history", kw)
    if err:
        return err
    hist = []
    if (node.get("state") or {}).get("type") == "canceled":
        hist.append({"disposition": "CANCELLED",
                     "reason": f"Linear state {node['state']['name']!r}",
                     "reversal_condition": None})
    return ok(ROLE, "get_decision_history", {"history": hist}, [_ref(node, "state.type")])


def _transport_detail():
    """Why this process cannot reach the transport, when it cannot.

    The engine's default message says "transport is not configured", which is
    false for a declared MCP binding -- it IS configured, by a human, and is
    simply not usable from here. A hook or CI subprocess has no MCP session and
    never will (ADR-016 rule 6), so this has to name which process is speaking.
    """
    if (binding().get("transport") or {}).get("kind") == "mcp":
        return ("MCP transport is declared but nothing has been supplied to this "
                "process. An agent session holding the MCP connection can fetch "
                "the issues and pipe them in with --input -; a hook, CI or "
                "headless run cannot, and needs LINEAR_API_KEY.")
    return None


def _probe():
    """Is the transport usable BY THIS PROCESS, right now?

    A declared MCP transport is deliberately NOT enough. Nothing here probes
    anything: there is no MCP client in this adapter, correctly (ADR-016), so
    returning true for a declared transport would report "reachable" on the
    strength of a word in a file.

    It also decided `writable`, which _protocol derives from this -- and that
    silenced WRITE_GRANTED_BUT_TRANSPORT_READONLY for a transport with no write
    path at all. Agent-supplied stdin is read-only by construction.

    And ADR-008 C2: capabilities must be exercisable by a probe. With MCP
    declared and nothing supplied, none of them are, so advertising them was a
    claim this adapter could not honour.

    `configured` stays true for a declared transport -- that is issue 124's
    fix and a separate axis. Declared, configured, and not yet reachable is a
    coherent state, and it is the true one.
    """
    if FIXTURE and Path(FIXTURE).exists():
        return True
    return bool(API_KEY)


FUNCTIONS = {
    "get_work": get_work,
    "get_status": get_status,
    "get_authority": get_authority,
    "get_scope": get_scope,
    "get_non_goals": get_non_goals,
    "get_acceptance_conditions": get_acceptance_conditions,
    "get_parent_or_goal": get_parent_or_goal,
    "get_decision_history": get_decision_history,
}

PROPERTIES = {
    "persistence": True,
    # Better than github-projects: Linear's state *type* is a stable, semantic
    # field, not a user-named column we interpret.
    "provenance_quality": "exact",
}

CAPABILITIES = {
    "work_lookup": True,
    "status": True,
    "authority": True,
    "cancellation_detection": True,
    "decision_history": True,
    "admission_distinction": True,   # triage vs backlog — GitHub cannot do this
    "scope": False,
    "non_goals": False,
    "acceptance_conditions": False,
}

def _configured():
    if FIXTURE:
        return True, None
    b = binding()
    if (b.get("transport") or {}).get("kind") == "mcp":
        return True, None
    if not API_KEY:
        return False, "LINEAR_API_KEY is unset; every query will refuse."
    return True, None

if __name__ == "__main__":
    sys.exit(main(ROLE, CAPABILITIES, FUNCTIONS,
                  {"name": "linear",
                   "permissions": {"read": True, "write": False},
                   "mode": "fixture" if FIXTURE else ("live" if API_KEY else
                          ("mcp" if (binding().get("transport") or {}).get("kind") == "mcp"
                           else "unconfigured"))},
                  properties=PROPERTIES, probe=_probe, config_probe=_configured,
                  transport_detail=_transport_detail))
