#!/usr/bin/env python3
"""ExecutionStateProvider backed by a local JSON file (spec §13, §62).

Synthetic reference implementation. `adapters/beads` is now the real backend
and reads the `bd export` JSONL rather than the `bd` CLI this docstring used
to point at -- ADR-016 prefers the CLI over the Beads MCP server and still
does, but it is silent on live-versus-committed, and ADR-033 is not: a
repo-local provider answers about the checked-out revision. See that
adapter's docstring for the argument.

INV-002 is the point of this role's separation: nothing here confers
roadmap authority. A task marked READY says the execution graph is ready,
not that the parent work is still authorized.
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
from _protocol import cite, fail, main, ok, unknown  # noqa: E402

ROLE = "execution"
SRC = Path(os.environ.get("REPO_GOVERNOR_EXECUTION", ".repo-governor/execution.json"))


def _probe():
    return SRC.exists()


def _root(fn, kw):
    if not _probe():
        return None, fail(ROLE, fn, "PROVIDER_UNAVAILABLE", f"{str(SRC)!r} does not exist")
    try:
        data = json.loads(SRC.read_text(encoding="utf-8"))
    except json.JSONDecodeError as e:
        return None, fail(ROLE, fn, "MALFORMED_SOURCE", f"{SRC} is not valid JSON: {e}")
    except OSError as e:
        return None, fail(ROLE, fn, "PROVIDER_UNAVAILABLE", f"cannot read {SRC}: {e}")
    if not isinstance(data.get("roots"), dict):
        return None, fail(ROLE, fn, "MALFORMED_SOURCE", "expected an object with a 'roots' map")
    wid = kw.get("id")
    if not wid:
        return None, fail(ROLE, fn, "BAD_REQUEST", "missing required argument: id=<authority-id>")
    r = data["roots"].get(wid)
    if r is None:
        return None, fail(ROLE, fn, "NOT_FOUND", f"no execution root for authority {wid!r}")
    return r, None


def _ref(wid, field):
    return cite("execution-file", f"{SRC}#roots.{wid}", field)


def find_execution_root(kw):
    r, err = _root("find_execution_root", kw)
    if err:
        return err
    return ok(ROLE, "find_execution_root",
              {"root": r["root_id"], "authority_id": r["authority_id"]},
              [_ref(kw["id"], "root_id")])


def get_tasks(kw):
    r, err = _root("get_tasks", kw)
    if err:
        return err
    t = r.get("tasks", [])
    by = {}
    for x in t:
        by[x["status"]] = by.get(x["status"], 0) + 1
    return ok(ROLE, "get_tasks", {"tasks": t, "count": len(t), "by_status": by},
              [_ref(kw["id"], "tasks")])


def get_dependencies(kw):
    r, err = _root("get_dependencies", kw)
    if err:
        return err
    return ok(ROLE, "get_dependencies", {"dependencies": r.get("dependencies", [])},
              [_ref(kw["id"], "dependencies")])


def get_completed_work(kw):
    r, err = _root("get_completed_work", kw)
    if err:
        return err
    done = [x for x in r.get("tasks", []) if x.get("status") == "DONE"]
    return ok(ROLE, "get_completed_work", {"completed": done, "count": len(done)},
              [_ref(kw["id"], "tasks[status=DONE]")])


def get_active_work(kw):
    r, err = _root("get_active_work", kw)
    if err:
        return err
    act = [x for x in r.get("tasks", []) if x.get("status") == "IN_PROGRESS"]
    return ok(ROLE, "get_active_work", {"active": act, "count": len(act)},
              [_ref(kw["id"], "tasks[status=IN_PROGRESS]")])


def get_failures(kw):
    r, err = _root("get_failures", kw)
    if err:
        return err
    return ok(ROLE, "get_failures", {"failures": r.get("failures", [])},
              [_ref(kw["id"], "failures")])


def get_discoveries(kw):
    """Discoveries default to CAPTURE_ONLY authority NONE (§32, INV-001)."""
    r, err = _root("get_discoveries", kw)
    if err:
        return err
    d = [{**x, "authority": "NONE", "default_disposition": "CAPTURE_ONLY"}
         for x in r.get("discoveries", [])]
    return ok(ROLE, "get_discoveries", {"discoveries": d, "count": len(d)},
              [_ref(kw["id"], "discoveries")])


def get_handoff_state(kw):
    r, err = _root("get_handoff_state", kw)
    if err:
        return err
    h = r.get("handoff")
    if h is None:
        return unknown(ROLE, "get_handoff_state",
                       reason="NO_HANDOFF_RECORDED",
                       detail=f"{kw['id']} has no handoff state; agent continuity is not recoverable.",
                       resolution="Record handoff state when an agent yields.",
                       blocking=False)
    return ok(ROLE, "get_handoff_state", {"handoff": h}, [_ref(kw["id"], "handoff")])


def get_execution_history(kw):
    r, err = _root("get_execution_history", kw)
    if err:
        return err
    return unknown(ROLE, "get_execution_history",
                   reason="HISTORY_NOT_RETAINED",
                   detail="This file provider stores current state only, not an append-only history.",
                   resolution="Bind Beads or another provider with durable execution history.",
                   blocking=False)


FUNCTIONS = {
    "find_execution_root": find_execution_root,
    "get_tasks": get_tasks,
    "get_dependencies": get_dependencies,
    "get_completed_work": get_completed_work,
    "get_active_work": get_active_work,
    "get_failures": get_failures,
    "get_discoveries": get_discoveries,
    "get_handoff_state": get_handoff_state,
    "get_execution_history": get_execution_history,
}

PROPERTIES = {"persistence": True, "provenance_quality": "exact"}

CAPABILITIES = {
    "execution_root": True,
    "tasks": True,
    "dependencies": True,
    "completed_work": True,
    "failures": True,
    "discoveries": True,
    "handoff_state": True,
    "execution_history": False,   # honest: current state only
}

if __name__ == "__main__":
    sys.exit(main(ROLE, CAPABILITIES, FUNCTIONS,
                  {"name": "execution-file", "permissions": {"read": True, "write": False}},
                  properties=PROPERTIES, probe=_probe))
