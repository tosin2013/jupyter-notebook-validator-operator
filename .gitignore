# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*
Dockerfile.cross

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go workspace file
go.work

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# editor and IDE paraphernalia
.idea
.vscode
*.swp
*.swo
*~

# Cursor IDE (hooks, skills, rules, MCP config are local tooling)
.cursor/

# Environment variables and secrets
.env
.env.*

# Test artifacts and logs
*.log
test-notebooks/

# Temporary files
*.tmp
*.bak

# MCP server context (auto-generated, contains session state)
.mcp-server-context.md
.mcp-adr-cache/

# Repo Governor hook session cache (per-machine, not shared)
.repo-governor/sessions/

# ROSA E2E state (credentials, local provisioning state)
.rosa-e2e-state/

# AWS CLI local install (from setup-rosa-e2e.sh)
aws/

# VHS demo rendered output (render locally with: vhs demo/<name>.tape)
demo/*.gif
demo/*.mp4
demo/*.webm

# Test results (local testing artifacts)
test-results.yaml

# =============================================================================
# Root-level development notes (internal session summaries, not for end users)
# =============================================================================
ADR-*-IMPLEMENTATION*.md
ADR-SUMMARY*.md
*-SESSION-SUMMARY.md
*-SUMMARY.md
*-COMPLETE.md
*-FIXES.md
*-FINDINGS.md
*-DEPLOYMENT.md
*-STATUS.md
OPERATOR-FEEDBACK.md
# Keep release notes in repo for documentation
# RELEASE_NOTES_*.md
RESOURCE-CONFLICT-*.md

# Keep these root files:
# - README.md (user-facing)
# - CLAUDE.md (development guidance)

# =============================================================================
# Internal Development Documentation (not for end users)
# These are progress tracking and implementation notes, not user documentation
# =============================================================================

# Phase completion and progress summaries
docs/PHASE*.md
docs/*_PROGRESS*.md
docs/*_COMPLETE*.md
docs/*_SUMMARY*.md

# Implementation planning documents
docs/IMPLEMENTATION*.md
docs/NEXT_TASK*.md
docs/NEXT_STEPS*.md

# Date-stamped internal documents
docs/*_2025-*.md

# Week summaries and internal tracking
docs/WEEK*.md

# Specific internal documents
docs/SECRETS_UPDATE_SUMMARY.md
docs/TEST_REPOSITORY_SETUP.md
docs/TEST_REPOSITORY_COMPLETE.md
docs/AUTHENTICATION_TESTING_COMPLETE.md
docs/CELL_ERROR_DISPLAY_FIX.md
